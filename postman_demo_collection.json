{
  "info": {
    "name": "Fuel Route API - Recording Demo (click Send)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Local API: http://127.0.0.1:8000. No authentication, environment or input edits needed.\nOpen these requests in numbered order. Click Send on each.\n01: Long trip: stops, quantities, purchase cost, starting-fuel value and route comparison.\n02: Same trip: meta.routing_api_calls=0 and route_from_cache=true.\n03: HTML map: open the response in a browser using the returned map_url; clicking Send fetches HTML.\n04: Charlotte: explain fuel + driving time at $50/hour + $5/stop.\n05: POST: partial starting tank, known starting price.\n06-07: Short trip: no purchases, but starting fuel still has a value; compare default price with $3.25.\n08-11: Outside-USA input, insufficient starting fuel, overfull tank and negative starting price.\nTests run automatically after Send; check the Test Results panel.\nStation coordinates are city representatives; station detours are not included. $5/stop is a six-minute allowance, not a measured stop duration.\n"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "01. Plan route (GET) - New York to Los Angeles",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://127.0.0.1:8000/api/route/?start=New+York%2C+NY&finish=Los+Angeles%2C+CA",
          "host": [
            "127",
            "0",
            "0",
            "1"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "New York, NY"
            },
            {
              "key": "finish",
              "value": "Los Angeles, CA"
            }
          ],
          "protocol": "http",
          "port": "8000"
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
