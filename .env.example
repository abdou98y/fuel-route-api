DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Free public OSRM server; point at a self-hosted instance for production.
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
HTTP_USER_AGENT=fuel-route-api/1.0 (you@example.com)
# Max distance (miles) between a station's city and the route.
MAX_STATION_DISTANCE_MILES=10
# Dollar value of one fuel stop's time; 0 = strictly cheapest plan.
STOP_PENALTY_USD=5
# Number of alternative routes requested, in addition to the primary route.
ROUTE_ALTERNATIVES=3
# Driver + truck cost excluding fuel, USD/hour of driving.
DRIVER_TRUCK_COST_PER_HOUR=50
